<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Escritório de Advocacia — [Nome do Advogado]</title>
<meta name="description" content="Escritório de advocacia com atendimento ético, transparente e personalizado. Agende sua consulta.">
<meta name="color-scheme" content="dark">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{color-scheme:dark;--bg:#080808;--gold:#C5A46D;--t:#fff;--m:#9b9b9b;--card:rgba(255,255,255,.04);--b:rgba(255,255,255,.09);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-behavior:smooth;scroll-padding-top:calc(76px + env(safe-area-inset-top,0px))}
*{box-sizing:border-box;margin:0}
body{background:var(--bg);color:var(--t);font:400 16px/1.6 Inter,system-ui,sans-serif;overflow-x:hidden;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:64px 64px}
a{color:inherit;text-decoration:none}
.w{max-width:1120px;margin:0 auto;padding:0 20px}
section{padding:84px 0}
.tag{display:inline-block;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--gold);border:1px solid var(--b);background:var(--card);padding:5px 14px;border-radius:99px;margin-bottom:18px}
h1,h2{font-weight:500;letter-spacing:-.03em;line-height:1.05;background:linear-gradient(180deg,#fff 20%,#6f6f6f);-webkit-background-clip:text;background-clip:text;color:transparent}
h1{font-size:clamp(40px,7vw,76px)}h2{font-size:clamp(30px,4.5vw,50px);margin-bottom:14px}
.sub{color:var(--m);max-width:560px;margin-bottom:40px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:12px;font-weight:500;font-size:15px;border:1px solid var(--b);background:var(--card);cursor:pointer;color:var(--t);font-family:inherit;transition:.25s}
.btn:hover{border-color:var(--gold);transform:translateY(-2px)}
.btn.g{background:var(--gold);color:#111;border-color:var(--gold)}.btn.g:hover{background:#d8b87d}
.card{background:var(--card);border:1px solid var(--b);border-radius:20px;padding:26px;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);transition:.3s}
.card:hover{border-color:rgba(197,164,109,.5);transform:translateY(-4px)}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
.card h3{font-weight:500;font-size:19px;margin:12px 0 6px}.card p{color:var(--m);font-size:14.5px}
.ic{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;font-size:20px;color:var(--gold);background:rgba(197,164,109,.1);border:1px solid rgba(197,164,109,.25)}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
header{position:fixed;top:0;left:0;right:0;z-index:50;padding-top:env(safe-area-inset-top,0px);background:rgba(8,8,8,.7);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--b)}
.nav{display:flex;align-items:center;justify-content:space-between;height:68px}
.logo{font-weight:600;letter-spacing:.02em}.logo b{color:var(--gold)}
nav{display:flex;gap:26px;font-size:14px;color:var(--m)}nav a:hover{color:var(--t)}
.menu{display:none;background:none;border:1px solid var(--b);color:var(--t);border-radius:10px;padding:8px 12px;font-size:18px}
#hero{padding-top:150px;position:relative;overflow:hidden}
.hg{display:grid;gap:40px;grid-template-columns:1.2fr .8fr;align-items:center}.sg{grid-template-columns:.8fr 1.2fr}h1,h2{overflow-wrap:anywhere}
.hero p{color:var(--m);font-size:18px;max-width:520px;margin:22px 0 4px}
.star{position:absolute;color:#cfcfcf;opacity:.55;filter:drop-shadow(0 0 18px rgba(197,164,109,.35));animation:fl 7s ease-in-out infinite}
@keyframes fl{50%{transform:translateY(-14px) rotate(6deg)}}
.photo{aspect-ratio:4/5;border-radius:26px;border:1px solid var(--b);background:radial-gradient(circle at 50% 30%,rgba(197,164,109,.18),transparent 60%),#111;display:grid;place-items:center;text-align:center;color:var(--m);font-size:13px;padding:20px;position:relative;overflow:hidden}
.photo svg{width:55%;opacity:.5}
